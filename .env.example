# Copy to .env and fill in.
#
# Only a developer build reads this file - `make dev`, or `go build -tags dev`.
# A released binary ignores it entirely, because zot runs unattended with a
# shell tool and must not take credentials from whatever directory it was
# pointed at.
#
# For a release binary, export these in your shell or put them in
# ~/.config/zot/config.yaml instead.

# Provider credentials. zot has no built-in providers and reads no conventional
# variable: declare a provider in the config with api_key: '$YOUR_VAR', then
# export YOUR_VAR here.
# GATEWAY_KEY=

# Optional: override config fields via ZOT_<PATH> (see configs/zot.example.yaml).
# ZOT_AGENT_MODEL=my-model
# ZOT_AGENT_MAX_ITERATIONS=1000000
# ZOT_DEFAULT_PROVIDER=mygateway
# ZOT_UI_DIFF=true       # show syntax-highlighted diffs (same as --diff)
# ZOT_UI_PLAIN=true      # force unstyled streaming output (same as --plain)
# ZOT_SESSION_DIR=       # where session logs are written
